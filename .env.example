PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wagering
DATABASE_POOL_MAX=20
WALLET_LOCK_TIMEOUT_MS=5000
TRANSACTION_MAX_ATTEMPTS=4
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wagering-events.fifo
WAGER_CONSUMER_ENABLED=true
OUTBOX_PUBLISHER_ENABLED=true
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
LOG_LEVEL=info
AUTH_MODE=jwt
AUTH_ISSUER=http://localhost:8080/realms/wagering
AUTH_AUDIENCE=wagering-processor

TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
