{
  "name": "wagering-processor",
  "version": "0.1.0",
  "description": "Distributed Wagering Processor \u2014 Jungle Gaming technical challenge",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "start:prod": "bun run dist/main.js",
    "typecheck": "tsc --noEmit",
    "migration:up": "bun run src/database/migrate.ts up",
    "migration:down": "bun run src/database/migrate.ts down",
    "migration:list": "bun run src/database/migrate.ts list",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun run test/load/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/nestjs": "^6.1.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bun": "^1.2.0",
    "@types/express": "^5.0.0",
    "typescript": "^5.7.0"
  }
}
